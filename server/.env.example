# ============================================================
# MUSELY — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# --- Database ---
# SQLite (development default)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production recommended)
# DATABASE_URL="postgresql://user:password@localhost:5432/musely_prod"

# --- JWT Authentication ---
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
LOG_LEVEL=info

# --- Email (SMTP) ---
# Required for: password reset emails, email OTP verification
# Supports: Gmail (use App Password), Outlook, Amazon SES, SendGrid SMTP
EMAIL_FROM="noreply@musely.in"
EMAIL_FROM_NAME="MUSELY"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# If using Gmail: enable 2FA and use an App Password (not your main password)
# https://support.google.com/accounts/answer/185833

# --- Cloudinary (Media Storage) ---
# Required for: production image uploads (avatars, posts, cover images)
# Free tier: 25GB storage, 25GB bandwidth/month
# Create account at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Google OAuth (future) ---
# Required for: "Continue with Google" sign-in
# Setup: https://console.cloud.google.com/apis/credentials
# Add authorized redirect: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# --- SMS / OTP (future) ---
# Required for: phone number registration and OTP login
# Recommended providers for India: Fast2SMS, Textlocal, MSG91
# MSG91 (popular in India): https://msg91.com
SMS_PROVIDER="msg91"
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="MUSELY"
MSG91_ROUTE="4"

# --- Production Only ---
# CORS origins (comma-separated)
ALLOWED_ORIGINS="https://musely.in,https://www.musely.in"
# Session secret (if using express-session)
SESSION_SECRET="your-session-secret-change-in-production"
