<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme - MUSELY dark brand -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/musely_dark</item>
        <item name="colorPrimaryDark">@color/musely_dark</item>
        <item name="colorAccent">@color/musely_pink</item>
        <item name="android:windowBackground">@color/musely_dark</item>
        <item name="android:statusBarColor">@color/musely_dark</item>
        <item name="android:navigationBarColor">@color/musely_dark</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

</resources>